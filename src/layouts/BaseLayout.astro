---
import { site } from '~/config/site';
import { ENTER_FLAG_SNIPPET } from '~/i18n/memory';
import { LOCALES, getLocale } from '~/i18n/locales';
import '~/styles/global.css';

interface Props {
  /** Locale code, or 'gate' for the language entry page. */
  lang: string;
  htmlLang?: string;
  title: string;
  description: string;
  /** The gate has no navigation chrome and no enter-reveal cover. */
  variant?: 'site' | 'gate';
  bodyClass?: string;
  /**
   * Sub-path after the locale segment, e.g. `projects/pravo365`. Drives the
   * hreflang set so a project page points at its own translations rather than
   * at six homepages.
   */
  altPath?: string;
  /** Open Graph image path relative to /public. Defaults to the site image. */
  ogImage?: string;
  ogImageAlt?: string;
  /**
   * For pages that must never be indexed or declared canonical — the 404,
   * which is served at every address that does not exist.
   */
  noindex?: boolean;
}

const {
  lang,
  htmlLang,
  title,
  description,
  variant = 'site',
  bodyClass = '',
  altPath = '',
  ogImage: ogImagePath = site.ogImage,
  ogImageAlt = `${site.author.name} — ${site.tagline}`,
  noindex = false,
} = Astro.props;

const htmlLangAttr = htmlLang ?? (variant === 'gate' ? 'en' : getLocale(lang).htmlLang);

/**
 * Absolute URLs need the production origin, which comes from SITE_URL /
 * VERCEL_PROJECT_PRODUCTION_URL through astro.config (see site-url.mjs).
 * Without it, canonical, og:url and hreflang are left out rather than pointed
 * at a guessed domain. The OG image then falls back to a root-relative path.
 */
const origin = noindex ? undefined : Astro.site;
const absolute = (path: string) => (origin ? new URL(path, origin).href : null);

const canonical = absolute(Astro.url.pathname);
const ogImage = absolute(ogImagePath) ?? ogImagePath;

const sub = altPath.replace(/^\/+|\/+$/g, '');
const alternates = origin
  ? LOCALES.map((locale) => ({
      hreflang: locale.htmlLang,
      href: new URL(sub ? `/${locale.route}/${sub}/` : `/${locale.route}/`, origin).href,
    }))
  : [];
// x-default points at the language gate, which only lists the locale
// homepages — so only those pages (and the gate) may name it. Subpages would
// get an annotation without a return link, which search engines drop.
const xDefault = origin && sub === '' ? new URL('/', origin).href : null;

/** Open Graph expects language_TERRITORY, not a BCP 47 tag. */
const OG_LOCALES: Record<string, string> = {
  en: 'en_US',
  cs: 'cs_CZ',
  sk: 'sk_SK',
  es: 'es_ES',
  sr: 'sr_RS',
  tr: 'tr_TR',
};

/**
 * One inline script, before first paint, doing only what must happen before
 * first paint: mark that JS is available (the CSS motion layer is gated on
 * it) and raise the entering flag so the transition panels are already opaque
 * when the browser paints. Everything else is deferred module script.
 */
const bootScript = `document.documentElement.classList.add('js');${
  variant === 'site' ? ENTER_FLAG_SNIPPET : ''
}`;
---

<!doctype html>
<html lang={htmlLangAttr} data-variant={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}

    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {variant === 'site' && <meta property="og:locale" content={OG_LOCALES[lang] ?? getLocale(lang).htmlLang} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- SVG for browsers that read it; the .ico, touch icon and manifest are
         for everything that does not (npm run icons). -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#08080a" />
    <meta name="color-scheme" content="dark" />

    <!--
      Both cuts of the display face are preloaded, and the reason is the name
      itself: the c-acute in "Mitrović" is U+0107, which lives in latin-ext,
      not latin. Every page renders that name at display size, so both files
      are on the critical path of every page whatever we do here — measured,
      not assumed. Preloading only the smaller latin cut left the larger,
      always-needed one to be discovered from CSS a round trip later, and made
      Chrome warn that the preload went unused on locales whose visible text
      is mostly latin-ext.

      This changes when the files start downloading, not how many bytes are
      fetched. The mono face is deliberately not preloaded: it sets small
      labels, so arriving a beat later costs nothing.
    -->
    <link
      rel="preload"
      href="/assets/fonts/inter-tight-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/inter-tight-latin-ext-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline set:html={bootScript} />
  </head>

  <body class={bodyClass} data-lang={lang}>
    <slot />

    <script>
      import { initCursorField } from '~/motion/pointer/cursorField';

      initCursorField();
    </script>
  </body>
</html>

<style is:global>
  /* The cursor field paints above the page and below the language transition,
     and never intercepts a click. It is created by the module only on a real
     mouse, so there is nothing here for touch or reduced motion to pay for. */
  .cursor-field {
    position: fixed;
    inset: 0;
    z-index: var(--z-gate);
    pointer-events: none;
  }

  /* Painted before the reveal module loads, so the cover is opaque on the
     very first frame of the destination page. */
  html[data-entering] .transition-cover {
    visibility: visible;
    pointer-events: auto;
  }

  html[data-entering] .transition-cover__panel {
    transform: scaleY(1);
  }

  html[data-entering] .transition-cover__label {
    opacity: 1;
  }

  html[data-entering] body {
    /* Nothing under the cover should be able to scroll while it is up. */
    overflow: hidden;
  }
</style>
