---
import { site } from '~/config/site';
import { ENTER_FLAG_SNIPPET } from '~/i18n/memory';
import { LOCALES, getLocale } from '~/i18n/locales';
import DepthRuntime from '~/motion/depth/DepthRuntime.astro';
import depthCss from '~/styles/depth.css?url';
import depthCssInline from '~/styles/depth.css?inline';
import { CALM_ATTRIBUTE, MOTION_STORAGE_KEY } from '~/motion/utils/env';
import '~/styles/global.css';

interface Props {
  /** Locale code, or 'gate' for the language entry page. */
  lang: string;
  htmlLang?: string;
  title: string;
  description: string;
  /** The gate has no navigation chrome and no enter-reveal cover. */
  variant?: 'site' | 'gate';
  bodyClass?: string;
  /**
   * Sub-path after the locale segment, e.g. `projects/pravo365`. Drives the
   * hreflang set so a project page points at its own translations rather than
   * at six homepages.
   */
  altPath?: string;
  /** Open Graph image path relative to /public. Defaults to the site image. */
  ogImage?: string;
  ogImageAlt?: string;
  /**
   * For pages that must never be indexed or declared canonical — the 404,
   * which is served at every address that does not exist.
   */
  noindex?: boolean;
  /**
   * How the depth stylesheet reaches the page. 'linked' (default): fetched
   * early, applied at the end of <body>, cached across pages. 'inline': in
   * the head — for the homepage, whose HTML spans two TCP windows anyway, so
   * the extra request would only cost it. (Not prefetched from there either:
   * any extra request before LCP costs the homepage a simulated round trip in
   * Lighthouse/PSI, measured 2.56 -> 2.71 s, even at idle priority.)
   */
  depthCss?: 'linked' | 'inline';
}

const {
  lang,
  htmlLang,
  title,
  description,
  variant = 'site',
  bodyClass = '',
  altPath = '',
  ogImage: ogImagePath = site.ogImage,
  ogImageAlt = `${site.author.name} — ${site.tagline}`,
  noindex = false,
  depthCss: depthMode = 'linked',
} = Astro.props;

const htmlLangAttr = htmlLang ?? (variant === 'gate' ? 'en' : getLocale(lang).htmlLang);

/**
 * Absolute URLs need the production origin, which comes from SITE_URL /
 * VERCEL_PROJECT_PRODUCTION_URL through astro.config (see site-url.mjs).
 * Without it, canonical, og:url and hreflang are left out rather than pointed
 * at a guessed domain. The OG image then falls back to a root-relative path.
 */
const origin = noindex ? undefined : Astro.site;
const absolute = (path: string) => (origin ? new URL(path, origin).href : null);

const canonical = absolute(Astro.url.pathname);
const ogImage = absolute(ogImagePath) ?? ogImagePath;

const sub = altPath.replace(/^\/+|\/+$/g, '');
const alternates = origin
  ? LOCALES.map((locale) => ({
      hreflang: locale.htmlLang,
      href: new URL(sub ? `/${locale.route}/${sub}/` : `/${locale.route}/`, origin).href,
    }))
  : [];
// x-default points at the language gate, which only lists the locale
// homepages — so only those pages (and the gate) may name it. Subpages would
// get an annotation without a return link, which search engines drop.
const xDefault = origin && sub === '' ? new URL('/', origin).href : null;

/** Open Graph expects language_TERRITORY, not a BCP 47 tag. */
const OG_LOCALES: Record<string, string> = {
  en: 'en_US',
  cs: 'cs_CZ',
  sk: 'sk_SK',
  es: 'es_ES',
  sr: 'sr_RS',
  tr: 'tr_TR',
};

/**
 * Calm is read before first paint, so a visitor who chose it never sees one
 * frame of the full-motion page. It runs on every page, the gate included:
 * a returning calm visitor arrives at the gate first, and its greeting morph
 * already asks `prefersReducedMotion()`, which honours the attribute.
 */
const CALM_SNIPPET = `try{if(localStorage.getItem('${MOTION_STORAGE_KEY}')==='calm')document.documentElement.setAttribute('${CALM_ATTRIBUTE}','')}catch(e){}`;

/**
 * One inline script, before first paint, doing only what must happen before
 * first paint: mark that JS is available (the CSS motion layer is gated on
 * it), apply Calm, and raise the entering flag so the transition panels are
 * already opaque when the browser paints. Everything else is deferred module
 * script. (integrations/csp.mjs hashes whatever this ends up being.)
 */
const bootScript = `document.documentElement.classList.add('js');${CALM_SNIPPET}${
  variant === 'site' ? ENTER_FLAG_SNIPPET : ''
}`;
---

<!doctype html>
<html lang={htmlLangAttr} data-variant={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}

    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {variant === 'site' && <meta property="og:locale" content={OG_LOCALES[lang] ?? getLocale(lang).htmlLang} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- SVG for browsers that read it; the .ico, touch icon and manifest are
         for everything that does not (npm run icons). -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#08080a" />
    <meta name="color-scheme" content="dark" />

    <!--
      Both cuts of the display face are preloaded, and the reason is the name
      itself: the c-acute in "Mitrović" is U+0107, which lives in latin-ext,
      not latin. Every page renders that name at display size, so both files
      are on the critical path of every page whatever we do here — measured,
      not assumed. Preloading only the smaller latin cut left the larger,
      always-needed one to be discovered from CSS a round trip later, and made
      Chrome warn that the preload went unused on locales whose visible text
      is mostly latin-ext.

      This changes when the files start downloading, not how many bytes are
      fetched. The mono face is deliberately not preloaded: it sets small
      labels, so arriving a beat later costs nothing.
    -->
    <link
      rel="preload"
      href="/assets/fonts/inter-tight-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/inter-tight-latin-ext-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!--
      The depth stylesheet is applied at the end of <body> (see there), but
      fetched from here: on a page whose HTML spans two TCP windows the link
      at the end only arrives with the second one, and the reveal waits for
      that stylesheet, so discovering it late cost the homepage a round trip
      of LCP. A preload starts it in the first window and blocks nothing.
    -->
    {variant === 'site' && depthMode === 'linked' && <link rel="preload" as="style" href={depthCss} />}
    {variant === 'site' && depthMode === 'inline' && <style is:inline set:html={depthCssInline} />}

    <script is:inline set:html={bootScript} />
  </head>

  <body class={bodyClass} data-lang={lang}>
    <slot />

    <script>
      import { initCursorField } from '~/motion/pointer/cursorField';

      initCursorField();
    </script>

    {/*
      The depth layer's stylesheet, linked rather than inlined, and last.
      Inlined it was ~0.9 KB brotli on every page, which pushed 66 case-study
      and laby pages past the first TCP window (14.6 KB), and the reveal waits
      for the whole HTML, so that cost a round trip of LCP. Linked at the end
      of the body it blocks nothing above it from painting, it is cached
      across pages, and it is still in place before anything is shown: a
      parser-inserted stylesheet blocks deferred and module scripts, so the
      reveal — which unhides the content — runs only once it has applied.
      At rest every depth primitive is identity, so the first paint is the
      same with or without it. Site pages only; the gate and the 404 use none.
      The homepage inlines it instead (depthCss="inline", see the head).
    */}
    {variant === 'site' && depthMode === 'linked' && <link rel="stylesheet" href={depthCss} />}

    {/* Site chrome: the gate and the 404 (both 'gate') neither run nor download it. */}
    {variant === 'site' && <DepthRuntime />}
  </body>
</html>

<style is:global>
  /* The cursor field paints above the page and below the language transition,
     and never intercepts a click. It is created by the module only on a real
     mouse, so there is nothing here for touch or reduced motion to pay for. */
  .cursor-field {
    position: fixed;
    inset: 0;
    z-index: var(--z-gate);
    pointer-events: none;
  }

  /* Painted before the reveal module loads, so the cover is opaque on the
     very first frame of the destination page. */
  html[data-entering] .transition-cover {
    visibility: visible;
    pointer-events: auto;
  }

  html[data-entering] .transition-cover__panel {
    transform: scaleY(1);
  }

  html[data-entering] .transition-cover__label {
    opacity: 1;
  }

  html[data-entering] body {
    /* Nothing under the cover should be able to scroll while it is up. */
    overflow: hidden;
  }
</style>
