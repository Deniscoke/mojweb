---
import { useTranslations } from '~/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const dict = useTranslations(lang);

/**
 * DEPTH (docs/motion-depth-plan.md §3.5). Two planes, and only decoration
 * moves between them. Each item's top rule draws itself in as the item
 * arrives, and the mono numeral sits on a farther plane, sliding a little
 * slower than the row (at most 1.8vh either way, less on a phone). Titles and
 * body copy never move and never fade. Under Calm this is today's list.
 */
---

<section class="section section--sm what" id="what" aria-labelledby="what-title">
  <div class="wrap">
    <header class="section__head grid12" data-reveal>
      <p class="mono section__label">
        <span class="section__index">02</span>
        {dict.services.label}
      </p>
      <div class="section__intro">
        <h2 id="what-title">{dict.services.title}</h2>
        <p class="lead">{dict.services.lead}</p>
      </div>
    </header>

    <ol class="what__list" role="list">
      {
        dict.services.items.map((item, index) => (
          <li class="what__item" data-reveal data-scrub="rule" style={`--reveal-delay:${index * 80}ms`}>
            <span class="mono what__index" data-depth="drift">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="what__title">{item.title}</h3>
            <p class="what__body">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .what__list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }

  /*
   * The top rule is the scrubbed hairline (styles/depth.css). It lives on the
   * item's own `::before`, so it shares no property with the reveal, which
   * owns the item's transform and opacity. The border stays as transparent
   * space, so the layout is exactly today's, and the hairline sits on it.
   */
  .what__item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--s-3) var(--s-4);
    padding-block: var(--s-6);
    border-block-start: 1px solid transparent;
    align-items: start;
  }

  .what__item::before {
    inset-block-start: -1px;
  }

  .what__item:last-child {
    border-block-end: 1px solid var(--c-line);
  }

  /* The far plane. Decorative only, and a block, so the drift has a box. */
  .what__index {
    --drift: -0.6;
    color: var(--c-bone-faint);
    padding-block-start: 0.45em;
  }

  .what__title {
    font-size: var(--t-h3);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tr-snug);
  }

  .what__body {
    grid-column: 2;
    color: var(--c-bone-dim);
    max-inline-size: 52ch;
    text-wrap: pretty;
  }

  @media (min-width: 62rem) {
    .what__item {
      grid-template-columns: 4rem minmax(0, 22rem) minmax(0, 1fr);
      gap: var(--s-6);
      align-items: baseline;
      padding-block: var(--s-7);
    }

    .what__body {
      grid-column: 3;
    }
  }
</style>
