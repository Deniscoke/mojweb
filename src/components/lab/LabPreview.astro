---
import { getExperiments } from '~/lib/cms';
import { localePath, t, useTranslations } from '~/i18n';
import { getScan, scanCaption } from '~/data/scans';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const dict = useTranslations(lang);
const experiments = await getExperiments(lang);

/**
 * The living scene turns into Denis's scan while this section is centred
 * (src/motion/scene). The scan keeps its `hero` approval record; it only
 * moved down the page. Both files must be in this build, or there is no scan.
 */
const approved = getScan('hero');
const scan =
  approved && [approved.files.desktop, approved.files.mobile].every((url) => existsSync(join(process.cwd(), 'public', url)))
    ? approved
    : undefined;

/**
 * THE LAB — a notebook, not a second project grid.
 *
 * v0.2 leans into the index/log register: three-digit entry numbers, a state
 * marker, a tag, and a right-hand note column. It shares the type scale,
 * spacing scale and colour system with the rest of the site, so it reads as
 * another room in the same building rather than another building. The only
 * thing it does differently is the cold accent, which appears nowhere else.
 *
 * DEPTH (docs/motion-depth-plan.md §3.6): the notebook under an instrument.
 * A short lab-green reading head travels down the list's margin as you
 * scroll, and since the list moves up while the head moves down, it hangs
 * close to the middle of the screen. It lives in the empty strip between the
 * entry numbers and the questions, so it points at the line being read and
 * never crosses a letter. On a desktop each entry number lights up in the
 * cold accent as its entry crosses that middle. The ink surface stays opaque
 * and nothing turns over. Under Calm this is today's notebook.
 *
 * This is a preview. The full list, with each question and note, lives at
 * /[lang]/lab/ and the entries that have a written log link on from there.
 */
---

<section
  class="section lab"
  id="lab"
  aria-labelledby="lab-title"
>
  <div class="wrap">
    <header
      class="section__head grid12"
      data-reveal
      data-scene="scan"
      data-scene-side="right"
      data-desktop={scan?.files.desktop}
      data-mobile={scan?.files.mobile}
    >
      <p class="mono section__label">
        <span class="section__index">03</span>
        {dict.lab.label}
      </p>
      <div class="section__intro">
        <h2 id="lab-title">{dict.lab.title}</h2>
        <p class="lead">{dict.lab.lead}</p>
        {
          /* What the points become here, and where the capture comes from.
             Under the lead, clear of the scan standing on the right. */
          scan && (
            <a class="mono lab__scan-cap" href={localePath(lang, scan.href)}>
              {scanCaption(scan, lang)}
              <span aria-hidden="true">→</span>
            </a>
          )
        }
      </div>
    </header>

    <ol class="lab__list" role="list">
      {
        experiments.map((item, index) => (
          <li class="lab__item" data-reveal style={`--reveal-delay:${Math.min(index, 6) * 45}ms`}>
            <span class="mono lab__num">{String(index + 1).padStart(3, '0')}</span>
            <span class="lab__title">{t(item.title, lang)}</span>
            <span class="mono lab__tag">{item.tag}</span>
            <span class="mono lab__state" data-state={item.state}>
              {dict.lab.states[item.state]}
            </span>
          </li>
        ))
      }
    </ol>

    <a class="action lab__all" href={localePath(lang, 'lab')}>
      {dict.lab.all}
      <span class="action__arrow" aria-hidden="true">&#8594;</span>
    </a>
  </div>
</section>

<style>
  .lab {
    /* Translucent: the living scene shows through the raised panel. */
    background-color: color-mix(in srgb, var(--c-ink) 45%, transparent);
    border-block: 1px solid var(--c-line);
  }

  /*
   * The index gutter is named once here, because the reading head below is
   * placed inside it: the number column and the gap after it.
   */
  .lab__list {
    --lab-gutter: 2.75rem;
    --lab-gap: var(--s-4);

    display: grid;
    margin: 0;
    padding: 0;
  }

  .lab__item {
    display: grid;
    grid-template-columns: var(--lab-gutter) minmax(0, 1fr);
    gap: var(--s-2) var(--lab-gap);
    padding-block: var(--s-5);
    border-block-start: 1px solid var(--c-line-strong);
    align-items: baseline;
  }

  .lab__item:last-child {
    border-block-end: 1px solid var(--c-line-strong);
  }

  .lab__num {
    color: var(--c-lab);
  }

  .lab__title {
    font-size: clamp(1.0625rem, 2.6vw, 1.5rem);
    font-weight: var(--fw-book);
    letter-spacing: var(--tr-snug);
    line-height: 1.2;
    text-wrap: pretty;
  }

  .lab__tag,
  .lab__state {
    grid-column: 2;
    color: var(--c-bone-faint);
  }

  .lab__state::before {
    content: '→ ';
  }

  .lab__state[data-state='open-question'] {
    color: var(--c-lab);
  }

  .lab__all {
    margin-block-start: var(--s-6);
  }

  @media (min-width: 48rem) {
    .lab__list {
      --lab-gutter: 3.5rem;
      --lab-gap: var(--s-5);
    }

    .lab__item {
      grid-template-columns: var(--lab-gutter) minmax(0, 1fr) 10rem 9rem;
      gap: var(--lab-gap);
      align-items: baseline;
    }

    .lab__tag {
      grid-column: 3;
    }

    .lab__state {
      grid-column: 4;
      text-align: end;
    }
  }

  .lab__scan-cap {
    display: inline-flex;
    margin-block-start: var(--s-3);
    align-items: center;
    gap: var(--s-2);
    min-block-size: 44px;
    color: var(--c-bone-faint);
    transition: color var(--d-fast) var(--e-out);
  }

  .lab__scan-cap:hover,
  .lab__scan-cap:focus-visible {
    color: var(--c-bone);
  }

  /* ------------------------------------------------------- the instrument */

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /*
       * The reading. On a desktop each entry number waits in faint bone and
       * takes the cold accent as it crosses the middle of the screen, which is
       * where the reading head hangs. A colour, on a three-digit label: a small
       * paint, not a layer. Phones keep today's numbers.
       */
      @media (min-width: 48rem) {
        :global(:root:not([data-calm])) .lab__num {
          animation: lab-num-read linear both;
          animation-timeline: view();
          animation-range: cover 44% cover 50%;
        }
      }
    }
  }

  @keyframes lab-num-read {
    from {
      color: var(--c-bone-faint);
    }

    to {
      color: var(--c-lab);
    }
  }
</style>
