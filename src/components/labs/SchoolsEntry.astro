---
import { LABS } from '~/data/labs';
import { localePath } from '~/i18n';
import { getLabsCopy } from '~/i18n/labs';

interface Props {
  lang: string;
}

/**
 * FOR SCHOOLS — the schools entry on every homepage.
 *
 * Sits directly under the hero. The hero stays about the person; this band is
 * where the project labs branch off, as the natural consequence of the work
 * listed further down the page rather than a separate business stuck on top.
 *
 * DEPTH (docs/motion-depth-plan.md §3.2). The band draws itself open: its top
 * and bottom rules are scrubbed hairlines instead of borders. Each lab entry
 * is a small tilt stage under a desktop mouse, and its glyph is the one layer
 * that lifts off it, in the lab's own colour. The glyphs stand up out of the
 * page as their row arrives (on a phone they slide in instead). Names and
 * questions stay flat: they are what is read. Under Calm this is today's band.
 */
const { lang } = Astro.props;
const copy = getLabsCopy(lang);
const labsHref = localePath(lang, 'laby');
---

<section class="section section--sm schools" id="pro-skoly" aria-labelledby="schools-title">
  <div class="wrap">
    <div class="schools__frame grid12" data-scrub="rule">
      <p class="mono section__label schools__label" data-reveal>
        <span class="section__index" aria-hidden="true">→</span>
        {copy.entry.label}
      </p>

      <div class="schools__intro" data-reveal style="--reveal-delay:80ms">
        <h2 id="schools-title" class="schools__title is-say">{copy.entry.title}</h2>
        <p class="lead schools__lead">{copy.entry.lead}</p>
      </div>

      <ul class="schools__labs" role="list" data-reveal style="--reveal-delay:160ms">
        {
          LABS.map((lab, index) => (
            <li style={`--lab-accent:${lab.world.accent};--i:${index}`}>
              <a class="schools__lab press" href={localePath(lang, `laby/${lab.slug}`)} data-tilt>
                <span class="schools__lift" data-lift aria-hidden="true">
                  <span class="mono schools__glyph" data-depth="rise">
                    {lab.glyph}
                  </span>
                </span>
                <span class="schools__lab-name">{lab.name}</span>
                <span class="schools__lab-q">{copy.labs[lab.slug].question}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="schools__foot" data-reveal style="--reveal-delay:220ms">
        <a class="action schools__cta" href={labsHref}>
          {copy.entry.cta}
          <span class="action__arrow" aria-hidden="true">&#8594;</span>
        </a>
        <p class="mono schools__group">{copy.group.short}</p>
      </div>

      <!-- The band's closing rule. An element of its own, so it draws as it
           arrives instead of with the top of a tall band. -->
      <span class="schools__rule-end" data-scrub="rule" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  /*
   * The frame's two rules are scrubbed hairlines (styles/depth.css), drawn at
   * rest exactly where the borders were. The borders stay, transparent, so
   * not a pixel of layout moves; each hairline sits on its border at -1px.
   */
  .schools__frame {
    --rule-color: var(--c-line-strong);
    position: relative;
    row-gap: var(--s-6);
    padding-block: clamp(2rem, 4vw, 3.5rem);
    border-block: 1px solid transparent;
  }

  .schools__frame::before {
    inset-block-start: -1px;
  }

  .schools__rule-end {
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    block-size: 1px;
  }

  .schools__label {
    grid-column: 1 / -1;
  }

  .schools__intro {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--s-4);
  }

  .schools__title {
    font-size: var(--t-display);
    max-inline-size: 18ch;
    text-wrap: balance;
  }

  .schools__lead {
    max-inline-size: 46ch;
  }

  /*
   * Five entries, laid out on purpose rather than with auto-fit (which left one
   * or two orphan cells on tablets): one column on phones, two columns with
   * the fifth entry spanning the row on tablets, five across on wide screens.
   */
  .schools__labs {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 var(--col-gap);
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--c-line);
  }

  @media (min-width: 36rem) {
    .schools__labs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .schools__labs > li:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 70rem) {
    .schools__labs {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .schools__labs > li:last-child {
      grid-column: auto;
    }
  }

  /*
   * Each entry is a tilt stage (src/motion/depth/tilt.ts): under a desktop
   * mouse it leans at most 4° each way. A stage may carry no opacity,
   * overflow, filter, mask or clip-path, so the glyph's lift keeps its 3D
   * context. On touch, `.press` sinks it a hair under the finger instead.
   */
  .schools__lab {
    --tilt-max-x: 4deg;
    --tilt-max-y: 4deg;
    display: grid;
    /* Rows hug their content, so every entry in a row starts at the same line. */
    align-content: start;
    gap: var(--s-2);
    block-size: 100%;
    padding: var(--s-5) var(--s-4) var(--s-5) 0;
    border-block-end: 1px solid var(--c-line);
    color: var(--c-bone);
    position: relative;
  }

  .schools__lab::before {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline: 0 var(--s-4);
    block-size: 2px;
    background-color: var(--lab-accent);
    transform: scaleX(0.18);
    transform-origin: left center;
    transition: transform var(--d-base) var(--e-out);
  }

  .schools__lab:hover::before,
  .schools__lab:focus-visible::before {
    transform: scaleX(1);
  }

  /* The lift is the stage's direct child, as the 3D context requires. A flex
     box, so the glyph inside it is laid out exactly as it was without one. */
  .schools__lift {
    display: flex;
    justify-self: start;
  }

  .schools__glyph {
    color: var(--lab-accent);
    font-size: var(--t-body);
    letter-spacing: 0;
    /* Staggered left to right, but every glyph still settles by `entry 25vh`:
       the first is upright 8vh early, the fifth exactly on time, so none is
       still moving inside the reading band. */
    --rise-offset: calc((var(--i, 4) - 4) * 2vh);
  }

  /* Lifted, the glyph glows faintly in its lab's colour, in proportion to how
     far it has come off the plate, so nothing pops as the tilt engages or
     settles. */
  .schools__lab[data-tilting] .schools__glyph {
    text-shadow: 0 0 0.9em color-mix(in srgb, var(--lab-accent) calc(var(--tilt-z, 0) * 60%), transparent);
  }

  /* A phone gets no rotation: each glyph slides in from the inline start as
     its row arrives, on the rise primitive's own range. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (max-width: 47.99rem) {
      :global(:root:not([data-calm])) .schools__glyph {
        animation-name: schools-glyph-in;
      }
    }
  }

  @keyframes schools-glyph-in {
    from {
      translate: -0.75rem 0;
    }
  }

  .schools__lab-name {
    font-family: var(--f-mono);
    font-size: var(--t-mono);
    letter-spacing: var(--tr-mono);
    text-transform: uppercase;
    color: var(--c-bone-dim);
  }

  .schools__lab-q {
    font-size: var(--t-h3);
    font-weight: var(--fw-light);
    letter-spacing: var(--tr-snug);
    line-height: 1.12;
    text-wrap: balance;
    transition: color var(--d-fast) var(--e-out);
  }

  .schools__lab:hover .schools__lab-q,
  .schools__lab:focus-visible .schools__lab-q {
    color: var(--lab-accent);
  }

  .schools__foot {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4) var(--s-6);
  }

  .schools__group {
    color: var(--c-bone-faint);
  }

  @media (min-width: 62rem) {
    .schools__label {
      grid-column: 1 / span 3;
      padding-block-start: 0.6em;
    }

    .schools__intro {
      grid-column: 4 / span 9;
    }
  }
</style>
