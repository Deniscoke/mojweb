---
import { site } from '~/config/site';
import { getLocale, useTranslations } from '~/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const dict = useTranslations(lang);
const locale = getLocale(lang);
const year = new Date().getFullYear();

/**
 * THE BOOKEND (docs/motion-depth-plan.md §3.10). The hero's column rules
 * return behind the footer: twelve on a desktop, four on a phone, standing
 * on the page's last edge. As the footer comes into view they rise from it,
 * so the grid that opened the page closes it, and they are fully up exactly
 * when the page runs out. Under Calm, without scroll timelines and without
 * JavaScript they simply stand.
 */
---

<footer class="footer">
  <div class="footer__rules grid12" aria-hidden="true">
    {Array.from({ length: 12 }, () => <span />)}
  </div>

  <div class="wrap footer__inner">
    <div class="footer__col">
      <p class="mono footer__brand">{site.brand}</p>
      <p class="footer__colophon">{dict.footer.colophon}</p>
    </div>

    <div class="footer__col footer__col--end">
      {
        locale.quality === 'working' && (
          <p class="mono working-note footer__working">{dict.footer.workingTranslation}</p>
        )
      }
      <p class="mono footer__legal">
        &copy; {year} {site.author.name}
      </p>
      <div class="footer__controls">
        <a class="mono footer__top" href="#hero">{dict.footer.backToTop}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    border-block-start: 1px solid var(--c-line);
    padding-block: var(--s-6) var(--s-7);
  }

  /* ----------------------------------------------------------- the bookend */

  /*
   * The same twelve columns as the hero's rules, on the same measure, faded
   * towards the page above so they read as the grid surfacing, not a table.
   * One box with one transform, not twelve: a single layer while it rises.
   */
  .footer__rules {
    position: absolute;
    inset-block: 0;
    inset-inline: 0;
    inline-size: min(100% - var(--gutter) * 2, var(--w-max));
    margin-inline: auto;
    pointer-events: none;
    transform-origin: 50% 100%;
    mask-image: linear-gradient(to top, #000 15%, transparent);
  }

  .footer__rules > span {
    border-inline-start: 1px solid var(--c-line);
    opacity: 0.55;
  }

  .footer__rules > span:first-child {
    border-inline-start: 0;
  }

  /* A phone's grid has four columns. */
  @media (max-width: 47.99rem) {
    .footer__rules > span:nth-child(n + 5) {
      display: none;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* They rise over the footer's own entry, and stand fully at its end:
         the last pixel of scroll. Easing out, so they settle as the page
         stops rather than arriving at speed. */
      :global(:root:not([data-calm])) .footer__rules {
        animation: footer-rules-rise cubic-bezier(0.33, 1, 0.68, 1) backwards;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }
    }
  }

  /* From a stub, not from nothing: at the start of the range the footer's
     foot is still below the viewport, so the stub is never seen, and the
     rules never become a non-invertible, zero-height transform. */
  @keyframes footer-rules-rise {
    from {
      scale: 1 0.04;
    }
  }

  /* ------------------------------------------------------------- the text */

  /* Positioned, so it paints above the rules that come before it. */
  .footer__inner {
    position: relative;
    display: grid;
    gap: var(--s-5);
  }

  .footer__col {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }

  .footer__brand {
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  .footer__colophon {
    color: var(--c-bone-faint);
    font-size: var(--t-mono);
    max-inline-size: 40ch;
    text-wrap: pretty;
  }

  .footer__legal,
  .footer__top {
    color: var(--c-bone-faint);
  }

  .footer__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-6);
  }

  .footer__top {
    min-block-size: 44px;
    display: inline-flex;
    align-items: center;
    transition: color var(--d-fast) var(--e-out);
  }

  .footer__top:hover,
  .footer__top:focus-visible {
    color: var(--c-bone);
  }

  @media (min-width: 48rem) {
    .footer__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .footer__col--end {
      justify-items: end;
      text-align: end;
    }

    .footer__controls {
      justify-content: flex-end;
    }
  }
</style>
