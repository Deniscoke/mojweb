---
import { site } from '~/config/site';
import { useTranslations } from '~/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const dict = useTranslations(lang);

/**
 * CONTACT — the closing statement.
 *
 * Nothing here is invented. `site.contact` ships with nulls, and a null
 * simply does not render: an honest "contact details are being added" beats a
 * plausible-looking address that bounces, and a CTA with no destination is
 * worse than no CTA.
 *
 * The page closes on the living scene drifting out (`data-scene="drift"`,
 * src/motion/scene): nothing is drawn over the text and the CTA. The line-drawing
 * stroke that used to close the page is gone — one moving system, not two.
 *
 * DEPTH (docs/motion-depth-plan.md §3.9): the landing. The title arrives
 * from slightly behind the page and has settled before it reaches the
 * reading band. The actions get no scroll motion at all.
 */
const email = site.contact.email;
const phone = site.contact.phone;
const links = site.contact.links.filter((link) => Boolean(link.href));
---

<section class="section section--lg contact" id="contact" data-scene="drift" data-scene-side="full" aria-labelledby="contact-title">
  <div class="wrap contact__inner">
    <p class="mono section__label" data-reveal>
      <span class="section__index">06</span>
      {dict.contact.label}
    </p>

    <!-- The approach wraps the title: the title's own reveal owns its transform. -->
    <div class="contact__approach" data-depth="approach">
      <h2 id="contact-title" class="contact__title is-say" data-reveal style="--reveal-delay:80ms">
        {dict.contact.title}
      </h2>
    </div>


    <p class="lead contact__lead" data-reveal style="--reveal-delay:200ms">{dict.contact.lead}</p>

    <div class="contact__actions" data-reveal style="--reveal-delay:260ms">
      {
        email ? (
          <>
            <a class="action" href={`mailto:${email}`}>
              {dict.contact.emailCta}
              <span class="action__arrow" aria-hidden="true">
                &#8599;
              </span>
            </a>
            <p class="mono contact__direct">
              <a class="link hit" href={`mailto:${email}`}>{email}</a>
              {phone && (
                <span class="contact__phone">
                  <span aria-hidden="true"> · </span>
                  <a class="link hit" href={`tel:${phone.replace(/\s+/g, '')}`}>{phone}</a>
                </span>
              )}
            </p>
          </>
        ) : (
          <p class="mono working-note">{dict.contact.pending}</p>
        )
      }
    </div>

    {
      links.length > 0 && (
        <div class="contact__elsewhere" data-reveal style="--reveal-delay:320ms">
          <p class="mono contact__elsewhere-label">{dict.contact.elsewhere}</p>
          <ul class="contact__links" role="list">
            {links.map((link) => (
              <li>
                <a class="link" href={link.href!} target="_blank" rel="noopener noreferrer me">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .contact__inner {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }

  /**
   * The shared `.section__label` carries `grid-column: span 4` for the
   * 12-column contexts it usually lives in. Here it silently gives this grid
   * four implicit tracks, and the auto-placed children then flow across them.
   * On a phone the last child lands past the right edge of the viewport, so
   * below the mobile breakpoint everything is pinned to one column.
   */
  @media (max-width: 47.99rem) {
    .contact__inner > * {
      grid-column: 1 / -1;
    }
  }

  /* Scales about its inline start, so the title keeps the page's left edge
     as it arrives. */
  .contact__approach {
    transform-origin: 0 50%;
  }

  .contact__title {
    font-size: var(--t-display);
    max-inline-size: 16ch;
    text-wrap: balance;
  }


  .contact__lead {
    max-inline-size: 40ch;
  }

  .contact__actions {
    margin-block-start: var(--s-2);
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }

  .contact__direct {
    color: var(--c-bone-dim);
    text-transform: none;
    letter-spacing: 0.04em;
  }

  /* The separator travels with the phone number, so a wrap never leaves a
     dangling "·" at the end of the e-mail line. */
  .contact__phone {
    white-space: nowrap;
  }

  @media (pointer: coarse) {
    .contact__direct .link {
      padding-block: 0.7em;
      margin-block: -0.7em; /* bigger target, same layout */
    }
  }

  .contact__elsewhere {
    display: grid;
    gap: var(--s-3);
    margin-block-start: var(--s-5);
  }

  .contact__elsewhere-label {
    color: var(--c-bone-faint);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    margin: 0;
    padding: 0;
  }
</style>
