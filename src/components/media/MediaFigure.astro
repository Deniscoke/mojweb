---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import PhotoWindow from './PhotoWindow.astro';
import { EVIDENCE } from '~/data/evidence';
import type { MediaItem } from '~/data/projects';

interface Props {
  item: MediaItem;
  /** First item on a page loads eagerly; the rest stay lazy. */
  priority?: boolean;
  /**
   * Opt in to the depth treatment by kind (see below). Off by default, so
   * pages that must stay still — the lab notes — stay exactly as they are.
   */
  depth?: boolean;
}

const { item, priority = false, depth = false } = Astro.props;

/**
 * EVIDENCE, not decoration.
 *
 * Two rules this component exists to enforce:
 *
 * 1. `alt` is never invented. When no alt text was written in the CMS the
 *    image is marked `aria-hidden` and given an empty alt, which is the
 *    correct way to say "decorative or undescribed" — far better than
 *    announcing a filename to a screen reader.
 * 2. Diagrams and screenshots are framed differently. A diagram needs padding
 *    and a light ground to be readable; a screenshot is the artefact itself
 *    and runs edge to edge.
 */
/**
 * Local evidence images ship with narrower siblings (`name-800w.webp`,
 * generated by `npm run images`). A phone then downloads a file sized for its
 * screen instead of the 1440 px desktop capture. Variants are only offered
 * when the file actually exists, so a CMS upload without them still renders.
 */
const VARIANT_WIDTHS = [640, 960];
const srcset = (() => {
  if (!item.url.startsWith('/media/') || !item.width) return undefined;
  const entries = VARIANT_WIDTHS.filter((w) => w < item.width!)
    .map((w) => ({ w, url: item.url.replace(/\.(webp|png|jpe?g)$/i, `-${w}w.webp`) }))
    .filter(({ url }) => existsSync(join(process.cwd(), 'public', url)));
  if (!entries.length) return undefined;
  return [...entries.map(({ w, url }) => `${url} ${w}w`), `${item.url} ${item.width}w`].join(', ');
})();
const sizes = '(min-width: 62rem) 70vw, 100vw';

const isVideo = item.kind === 'video' || item.mimeType.startsWith('video/');
const described = Boolean(item.alt);

const ratio = item.width && item.height ? `${item.width} / ${item.height}` : undefined;

/**
 * Where the subject sits, from the evidence record when this file came from
 * one. CMS media carry no focal point yet and frame from the centre.
 */
const focal = EVIDENCE.find((spec) => `/media/evidence/${spec.file}` === item.url)?.focal;
const objectPosition = focal ? `object-position:${focal[0]}% ${focal[1]}%` : undefined;

/**
 * DEPTH BY KIND
 * =============
 *   photo, generated   Tier 0 window: the image moves inside its frame on
 *                      scroll, at identity in the reading band. The figure
 *                      rises on entry.
 *   screenshot         Monitor settle: the frame stands up from a slight
 *                      recline as it enters (desktop), or slides up (phone).
 *   diagram            Never moves. It has to be read.
 *   video              Never moves.
 *
 * The priority image is the page's LCP: it keeps the window — a transform
 * inside its own frame — and nothing else. Never opacity, never a rise.
 *
 * Tier 1 (the depth-map shader) needs consent recorded as `adult`, and
 * evidence records no consent, so evidence photos are Tier 0. Photos that
 * may go further are registered in src/data/photos.ts.
 */
const windowed = depth && !isVideo && (item.kind === 'photo' || item.kind === 'generated');
const settles = depth && !priority && item.kind === 'screenshot';
const rises = windowed && !priority;
---

<figure
  class="media"
  data-kind={item.kind}
  data-depth={rises ? 'rise' : undefined}
  data-settle={settles ? '' : undefined}
>
  {
    windowed ? (
      <PhotoWindow
        src={item.url}
        srcset={srcset}
        sizes={sizes}
        alt={item.alt}
        width={item.width}
        height={item.height}
        focal={focal}
        priority={priority}
      />
    ) : (
      <div class="media__frame" style={ratio ? `--media-ratio:${ratio}` : undefined}>
        {isVideo ? (
          <video
            class="media__el"
            src={item.url}
            controls
            preload="metadata"
            playsinline
            width={item.width ?? undefined}
            height={item.height ?? undefined}
          />
        ) : (
          <img
            class="media__el"
            src={item.url}
            srcset={srcset}
            sizes={srcset ? sizes : undefined}
            alt={item.alt ?? ''}
            aria-hidden={described ? undefined : 'true'}
            width={item.width ?? undefined}
            height={item.height ?? undefined}
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : undefined}
            decoding="async"
            style={objectPosition}
          />
        )}
      </div>
    )
  }

  {
    (item.caption || item.credit) && (
      <figcaption class="media__caption">
        {item.caption}
        {item.credit && <span class="media__credit">{item.credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .media {
    margin: 0;
    display: grid;
    gap: var(--s-3);
  }

  .media__frame {
    aspect-ratio: var(--media-ratio, 16 / 10);
    overflow: hidden;
    background-color: var(--c-ink);
    border: 1px solid var(--c-line);
  }

  .media__el {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  /**
   * A diagram is information, not an artefact: it needs air and must never be
   * cropped by an object-fit cover.
   *
   * The ground is the raised ink surface rather than bone, because portfolio
   * diagrams are authored in the site's own palette (see
   * docs/diagram-style.md). A light frame would put a white slab in the
   * middle of a dark page for no reason.
   */
  .media[data-kind='diagram'] .media__frame {
    background-color: var(--c-ink);
    padding: clamp(0.75rem, 2vw, 1.5rem);
  }

  .media[data-kind='diagram'] .media__el {
    object-fit: contain;
  }

  /* Long enough to be a sentence, so it is set as one — the mono micro-label
     register is for two or three words, not for a line of prose. */
  .media__caption {
    color: var(--c-bone-faint);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    font-size: var(--t-small, 0.875rem);
    line-height: 1.45;
    text-wrap: pretty;
    max-inline-size: 68ch;
  }

  .media__credit {
    color: var(--c-bone-dim);
  }

  .media__credit::before {
    content: '— ';
  }

  /*
   * MONITOR SETTLE. A screenshot is a screen, so it arrives like one being
   * set upright: reclined 6° about its bottom edge, standing up by the time
   * its top reaches 75% of the viewport. Perspective sits on the frame itself,
   * never on an ancestor. The caption stays flat. On a phone there is no
   * rotation at all; the whole figure slides up instead, caption included,
   * so the frame can never ride over its own caption.
   *
   * The figure is the timeline subject and does not move on desktop; on a
   * phone it does, which a view timeline ignores (it measures layout, not
   * transforms). Entry only, fill backwards: after the range it is gone, and
   * the frame is `transform: none` again.
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(:root:not([data-calm])) .media[data-settle] {
        view-timeline: --settle block;
      }

      :global(:root:not([data-calm])) .media[data-settle] .media__frame {
        transform-origin: 50% 100%;
        animation: media-settle linear backwards;
        animation-timeline: --settle;
        animation-range: entry 0% entry 25vh;
      }

      @media (max-width: 47.999rem) {
        :global(:root:not([data-calm])) .media[data-settle] .media__frame {
          animation: none;
        }

        :global(:root:not([data-calm])) .media[data-settle] {
          animation: media-settle-flat linear backwards;
          animation-timeline: --settle;
          animation-range: entry 0% entry 25vh;
        }
      }
    }
  }

  @keyframes media-settle {
    from {
      transform: perspective(var(--persp, 1100px)) rotateX(6deg);
    }
    to {
      transform: perspective(var(--persp, 1100px)) rotateX(0deg);
    }
  }

  @keyframes media-settle-flat {
    from {
      translate: 0 1.25rem;
    }
    to {
      translate: 0 0;
    }
  }
</style>
