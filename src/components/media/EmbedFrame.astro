---
import ProjectVisual from '~/components/projects/ProjectVisual.astro';
import type { EmbedSpec } from '~/data/embeds';
import type { ProjectVisual as Visual } from '~/data/projects';
import { useTranslations } from '~/i18n';

interface Props {
  embed: EmbedSpec;
  lang: string;
  /** The project's own plate stands in for the scene until it is asked for. */
  visual: Visual;
  hue: number;
  seed: string;
}

const { embed, lang, visual, hue, seed } = Astro.props;
const dict = useTranslations(lang);

/**
 * CLICK TO LOAD
 * =============
 * The scene is someone else's application: about a megabyte of script before
 * it draws anything, plus that site's own analytics and error reporting. None
 * of it is requested until the visitor presses the button. Until then this is
 * the project's own generated plate and a plain button, so the page costs
 * exactly what it did before the embed existed, and nobody's browser talks to
 * a third party they did not choose.
 *
 * The link underneath always works, including with JavaScript off.
 *
 * DEPTH, AND LETTING GO OF IT (motion depth plan §3.12)
 * Under a mouse, the poster's plate is a tilt stage: it leans a few degrees
 * behind the flat glass of the button, and its accent sheet lifts off. The
 * button and its note sit outside the stage, so the primary target never
 * moves; the overlay lets the pointer through to the plate everywhere else.
 *
 * Pressing the button lets go of all of it. The handler marks the figure
 * `data-loaded` in the same dispatch that swaps the poster for the iframe,
 * and from then on nothing inside the figure may carry a transform: the
 * scene is someone else's application and never sits in a 3D context. The
 * tilt module ignores anything inside `[data-loaded]` too.
 *
 * The plate is the poster, and there is no GL context on this page to release.
 */
const pick = (text: Record<'en' | 'cs' | 'sk', string> | undefined) =>
  text ? ((text as Record<string, string>)[lang] ?? text.en) : undefined;

const title = pick(embed.title)!;
const caption = pick(embed.caption);
const host = new URL(embed.src).host;
---

<figure class="embed" data-embed>
  <div class="embed__frame" style={`--embed-ratio:${embed.ratio}`}>
    <div class="embed__poster" data-embed-poster>
      <div class="embed__stage" data-tilt>
        <ProjectVisual visual={visual} hue={hue} seed={seed} class="embed__plate" layered />
      </div>
      <div class="embed__cta">
        <button
          type="button"
          class="action embed__load"
          data-embed-load
          data-src={embed.src}
          data-title={title}
        >
          <span class="embed__play" aria-hidden="true">&#9654;</span>
          {dict.project.embed.load}
        </button>
        <p class="embed__note">{dict.project.embed.note.replace('{host}', host)}</p>
      </div>
    </div>
  </div>

  <figcaption class="embed__caption">
    {caption && <span>{caption}</span>}
    <a class="link hit embed__open" href={embed.src} target="_blank" rel="noopener">
      {dict.project.embed.open}
      <span aria-hidden="true"> &#8599;</span>
    </a>
  </figcaption>
</figure>

<style>
  .embed {
    margin: 0;
    display: grid;
    gap: var(--s-3);
  }

  .embed__frame {
    position: relative;
    aspect-ratio: var(--embed-ratio, 16 / 9);
    overflow: hidden;
    background-color: var(--c-ink);
    border: 1px solid var(--c-line);
  }

  .embed__poster,
  .embed__frame :global(iframe) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    border: 0;
  }

  /*
   * The tilt stage. It fills the frame and is tuned like the case-study
   * plate it stands in for: a long perspective and small angles for a
   * full-width object. The stage carries nothing that would flatten it, so
   * the plate's dimming sits on its two sheets instead: the print and the
   * accent lift are both at 55%, and the lift floats off at the strength the
   * accent had at rest.
   */
  .embed__stage {
    --persp: 2400px;
    --tilt-max-x: 3deg;
    --tilt-max-y: 5deg;
    --lift: 40px;
    position: absolute;
    inset: 0;
  }

  .embed__stage :global(svg) {
    opacity: 0.55;
  }

  /* The overlay is glass: the pointer passes through it to the stage, and
     only its contents (the button, the note) take it. */
  .embed__cta {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--s-3);
    padding: var(--s-5);
    text-align: center;
    background: radial-gradient(closest-side, rgb(8 8 10 / 0.82), rgb(8 8 10 / 0.35));
    pointer-events: none;
  }

  .embed__cta > * {
    pointer-events: auto;
  }

  /* Loaded: the iframe never sits in a 3D context, whatever a future rule says. */
  .embed[data-loaded],
  .embed[data-loaded] :global(*) {
    transform: none;
    translate: none;
    rotate: none;
    scale: none;
  }

  .embed__load {
    font-size: var(--t-small, 0.875rem);
    cursor: pointer;
  }

  .embed__play {
    color: var(--c-signal);
  }

  .embed__note {
    max-inline-size: 42ch;
    margin: 0;
    color: var(--c-bone-dim);
    font-size: var(--t-mono);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* Too cramped for a sentence under the button on a phone; the button and
     the caption link below still say everything that matters. */
  @media (max-width: 29.99rem) {
    .embed__note {
      display: none;
    }
  }

  .embed__caption {
    color: var(--c-bone-faint);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3) var(--s-5);
    font-size: var(--t-small, 0.875rem);
    line-height: 1.45;
  }

  .embed__open {
    color: var(--c-bone-dim);
    white-space: nowrap;
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-embed-load]')) {
    button.addEventListener(
      'click',
      () => {
        const figure = button.closest<HTMLElement>('[data-embed]');
        const poster = figure?.querySelector<HTMLElement>('[data-embed-poster]');
        if (!figure || !poster) return;
        figure.dataset.loaded = '';

        const frame = document.createElement('iframe');
        frame.src = button.dataset.src ?? '';
        frame.title = button.dataset.title ?? '';
        frame.allow = 'fullscreen; xr-spatial-tracking; gyroscope; accelerometer';
        frame.allowFullscreen = true;
        frame.referrerPolicy = 'strict-origin-when-cross-origin';
        // Scripts and its own origin (storage, workers, WebAssembly) are what
        // the scene needs; navigating this page away is not.
        frame.setAttribute(
          'sandbox',
          'allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-pointer-lock',
        );

        poster.replaceWith(frame);
        frame.focus();
      },
      { once: true },
    );
  }
</script>
