---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Readout from '~/components/ui/Readout.astro';
import { site } from '~/config/site';
import { getScan, scanCaption } from '~/data/scans';
import { getExperiments, getProjects } from '~/lib/cms';
import { getLocale, localePath, useTranslations } from '~/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const dict = useTranslations(lang);
const locale = getLocale(lang);

const [projects, experiments] = await Promise.all([
  getProjects(lang),
  getExperiments(lang),
]);

const [firstName, ...rest] = site.author.name.split(' ');
const lastName = rest.join(' ');

const readout = [
  { key: 'Locale', value: locale.label, accent: true },
  { key: 'Projects', value: String(projects.length).padStart(2, '0') },
  { key: 'Live', value: String(projects.filter((p) => p.status.includes('live')).length).padStart(2, '0') },
  { key: 'Experiments', value: String(experiments.length).padStart(2, '0') },
];

/**
 * Denis's own captured point cloud, if one is approved for the hero AND both
 * of its files are in this build. Otherwise neither the host nor the caption
 * is rendered, and the hero is the floor alone, which is still the idea.
 */
const approved = getScan('hero');
const scan =
  approved && [approved.files.desktop, approved.files.mobile].every((url) => existsSync(join(process.cwd(), 'public', url)))
    ? approved
    : undefined;
---

<section class="hero" id="hero" data-hero>
  <!-- Column rules. The editorial grid, made faintly visible. On a desk, as
       the hero scrolls out they lie down into a floor (see "The floor"
       below). -->
  <div class="hero__rules grid12" aria-hidden="true">
    {Array.from({ length: 12 }, () => <span />)}
  </div>

  <!-- Desktop: the same twelve rules as they are once lying down — lit, solid
       at the hinge, fading only at the far edge, closed by a ground rule.
       Nothing is painted until the page moves (opacity 0 at rest). -->
  <div class="hero__floor grid12" aria-hidden="true">
    {Array.from({ length: 12 }, () => <span />)}
  </div>

  <!-- Below 62rem: the stage's ground, drawn once in perspective, static. Its
       lines run up from the front of the stage and stop at an oval clearing
       where the object stands, so no line ever crosses the scan. In the SVG
       one unit is one CSS pixel (the band is 11rem = 176 units tall); x is
       measured from the centre, where the anchor below puts the object. -->
  <div class="hero__ground" aria-hidden="true">
    <svg viewBox="-500 0 1000 176" preserveAspectRatio="xMidYMid slice" focusable="false">
      <defs>
        <radialGradient id="hero-ground-hole">
          <stop offset="0.8" stop-color="#000" />
          <stop offset="1" stop-color="#fff" />
        </radialGradient>
        <linearGradient id="hero-ground-depth" x1="0" y1="64" x2="0" y2="176" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#555" />
          <stop offset="0.3" stop-color="#fff" />
          <stop offset="0.82" stop-color="#fff" />
          <stop offset="1" stop-color="#000" />
        </linearGradient>
        <linearGradient id="hero-ground-sides" x1="-200" y1="0" x2="200" y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#000" />
          <stop offset="0.24" stop-color="#fff" />
          <stop offset="0.76" stop-color="#fff" />
          <stop offset="1" stop-color="#000" />
        </linearGradient>
        <mask id="hero-ground-clear" maskUnits="userSpaceOnUse" x="-500" y="0" width="1000" height="176">
          <rect x="-500" y="0" width="1000" height="176" fill="#fff" />
          <ellipse cx="0" cy="102" rx="144" ry="56" fill="url(#hero-ground-hole)" />
        </mask>
        <mask id="hero-ground-fade" maskUnits="userSpaceOnUse" x="-500" y="0" width="1000" height="176">
          <rect x="-500" y="0" width="1000" height="176" fill="url(#hero-ground-depth)" />
        </mask>
        <mask id="hero-ground-edge" maskUnits="userSpaceOnUse" x="-500" y="0" width="1000" height="176">
          <rect x="-500" y="0" width="1000" height="176" fill="url(#hero-ground-sides)" />
        </mask>
      </defs>
      <g mask="url(#hero-ground-edge)">
        <g mask="url(#hero-ground-fade)">
          <g mask="url(#hero-ground-clear)">
            {
              /* Receding lines: one every 88 px along the front edge (the
                 phone's column rhythm), all converging on a point 60 px
                 above the band. The pair either side of the centre is left
                 out: under the object they would read as its legs. */
              [132, 220, 308, 396].flatMap((x) => [x, -x]).map((x) => (
                <line x1={x} y1="176" x2={(x * 124) / 236} y2="64" />
              ))
            }
            {
              /* Cross lines at equal steps of depth (1 / distance), from the
                 far edge forward. */
              [64.5, 81.5, 103.5, 133.5].map((y) => <line class="is-cross" x1="-500" y1={y} x2="500" y2={y} />)
            }
          </g>
        </g>
      </g>
    </svg>
  </div>

  {
    /* The scan host. The engine appends its own canvas here once the page has
       revealed, loaded and gone idle, and only on a GPU that can afford it. */
    scan && <div class="hero__scan" aria-hidden="true" data-desktop={scan.files.desktop} data-mobile={scan.files.mobile} />
  }

  <div class="wrap hero__inner grid12">
    <p class="mono hero__role" data-reveal>{site.author.role}</p>

    <div class="hero__block">
      <h1 class="hero__name is-name" data-reveal-lines>
        <span class="line"><span class="line__inner">{firstName}</span></span>
        <span class="line"
          ><span class="line__inner" style="--reveal-delay:90ms">{lastName}</span></span
        >
      </h1>

      <p class="hero__statement is-say" data-reveal style="--reveal-delay:280ms" data-scan-mask>
        {dict.hero.statement}
      </p>
    </div>

    <p class="mono hero__disciplines" data-reveal style="--reveal-delay:400ms" data-parallax="0.4">
      {site.author.disciplines.join('  ·  ')}
    </p>

    <div class="hero__aside" data-reveal style="--reveal-delay:460ms" data-parallax="0.8" data-scan-mask>
      <Readout rows={readout} />
      <p class="hero__intro">{dict.hero.intro}</p>
    </div>

    <a class="mono hero__cue" href="#work" data-reveal style="--reveal-delay:560ms" data-scan-mask>
      <span class="hero__cue-line" aria-hidden="true"></span>
      {dict.hero.scrollCue}
    </a>

    <!-- The stage (below 62rem): a fixed band under the readout, part of the
         layout from first paint, where the scan stands. Empty, it is still a
         floor: the ground (.hero__ground) is drawn in it whether or not a
         scan ever arrives. -->
    <div class="hero__stage" aria-hidden="true"></div>

    {
      /* The box the scan stands in: its centre, its width, and its bottom
         edge as the ground. It lives in this grid, not over it, so it is
         placed by the same rows as the readout and can never sink into it.
         Absolutely placed: it takes no part in the grid's flow. */
      scan && <span class="hero__scan-anchor" aria-hidden="true" />
    }

    {
      /* What the scan is, and where it comes from. It captions a JS-only
         visual, so it ships hidden and heroScan shows it once a frame is
         actually on screen. Absolutely placed: showing it moves nothing. */
      scan && (
        <a class="mono hero__scan-cap" href={localePath(lang, scan.href)} hidden>
          {scanCaption(scan, lang)}
          <span class="hero__scan-arrow" aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</section>

<style>
  .hero {
    min-block-size: 86svb;
    display: flex;
    align-items: center;
    padding-block: clamp(4rem, 10vh, 8rem) var(--s-8);
    position: relative;
  }

  /* ---------------------------------------------------------- column rules */

  .hero__rules {
    position: absolute;
    inset-block: 0;
    inset-inline: 0;
    inline-size: min(100% - var(--gutter) * 2, var(--w-max));
    margin-inline: auto;
    pointer-events: none;
    /* Never the scroll anchor. When the phone nav folds on the first scroll,
       the browser keeps the page still by anchoring to what the reader sees;
       a rule whose floor animation attaches in that same moment would
       suppress the anchoring and the whole page would jump. */
    overflow-anchor: none;
    /* Faded top and bottom so the grid reads as a watermark of the layout
       rather than as a table. */
    mask-image: linear-gradient(to bottom, transparent, #000 25%, #000 65%, transparent);
  }

  .hero__rules > span {
    border-inline-start: 1px solid var(--c-line);
    opacity: 0.55;
  }

  .hero__rules > span:first-child {
    border-inline-start: 0;
  }

  /* Below 62rem the rules stop above the scroll cue: the stage under it has
     a ground of its own (below), and a rule running on through the band
     would cut through the object standing there. A phone's grid has four
     columns, so it gets four rules, not twelve. */
  @media (max-width: 61.99rem) {
    .hero__rules {
      --stage-reach: calc(var(--s-7) + 11rem + var(--s-5) + 44px);
      mask-image: linear-gradient(
        to bottom,
        transparent,
        #000 20%,
        #000 calc(100% - var(--stage-reach) - 6rem),
        transparent calc(100% - var(--stage-reach))
      );
    }
  }

  @media (max-width: 47.99rem) {
    .hero__rules > span:nth-child(n + 5) {
      display: none;
    }
  }

  /* ------------------------------------------------------------- the floor */

  /**
   * Desktop. The same twelve rules, drawn as they are once they lie down:
   * lit (bone, not the faint line colour of the standing grid), solid at the
   * hinge where the floor meets the reader, fading only towards the far
   * edge, and closed by a ground rule along the hinge. At rest it paints
   * nothing; as the page moves it turns with the standing rules and takes
   * over from them (see "The floor" below).
   */
  .hero__floor {
    --floor-line: color-mix(in srgb, var(--c-bone) 16%, transparent);
    position: absolute;
    inset: 0;
    inline-size: min(100% - var(--gutter) * 2, var(--w-max));
    margin-inline: auto;
    pointer-events: none;
    overflow-anchor: none;
    opacity: 0;
    border-block-end: 1px solid color-mix(in srgb, var(--c-bone) 26%, transparent);
    /* Two cross rules, one column pitch apart, so the first cells off the
       hinge are square: foreshortened, they are what makes it a floor. Only
       two, and only near the hinge, so they stay below the readout. */
    --floor-pitch: calc((min(100vw - var(--gutter) * 2, var(--w-max)) + var(--col-gap)) / 12);
    --floor-cross: linear-gradient(var(--floor-line), var(--floor-line));
    background:
      var(--floor-cross) 0 calc(100% - var(--floor-pitch)) / 100% 1px no-repeat,
      var(--floor-cross) 0 calc(100% - var(--floor-pitch) * 2) / 100% 1px no-repeat;
    /* Solid for the near three quarters, so as it lies down its far edge
       comes back to meet the object's base, then passes under it. */
    mask-image: linear-gradient(to bottom, transparent 2%, #000 30%);
  }

  .hero__floor > span {
    border-inline-start: 1px solid var(--floor-line);
  }

  .hero__floor > span:first-child {
    border-inline-start: 0;
  }

  /**
   * Below 62rem: the stage's ground. Drawn in perspective once, in the band
   * the scan stands in (the host lies exactly over it), under the canvas.
   * Static on purpose: a phone does not rotate anything (§1 rule 8), so the
   * floor is drawn already lying down rather than squashed into place.
   */
  .hero__ground {
    display: none;
    position: absolute;
    inset: auto 0 var(--s-7);
    inline-size: min(100% - var(--gutter) * 2, var(--w-max));
    block-size: 11rem;
    margin-inline: auto;
    pointer-events: none;
    overflow-anchor: none;
  }

  .hero__ground svg {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
  }

  .hero__ground line {
    stroke: var(--c-bone);
    stroke-opacity: 0.2;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .hero__ground line.is-cross {
    shape-rendering: crispEdges;
  }

  @media (max-width: 61.99rem) {
    .hero__floor {
      display: none;
    }

    .hero__ground {
      display: block;
    }
  }

  /* -------------------------------------------------------------- the scan */

  /**
   * Over the whole hero, under the text. The engine draws its canvas over
   * the whole host and stands the object in `.hero__scan-anchor`, a box in
   * the hero's own grid (below), so the grid places it, not the window.
   *
   * Desktop: the mask only keeps it off the statement (which ends near half
   * the width); it used to start inside the object and fade its whole left
   * half out.
   */
  .hero__scan {
    position: absolute;
    inset: 0;
    z-index: var(--z-ambient);
    pointer-events: none;
    overflow-anchor: none;
    mask-image: linear-gradient(to right, transparent 44%, #000 54%);
  }

  .hero__scan-anchor {
    position: absolute;
    visibility: hidden;
    pointer-events: none;
  }

  .hero__scan-cap {
    position: absolute;
    color: var(--c-bone-faint);
    white-space: nowrap;
    transition: color var(--d-fast) var(--e-out);
  }

  .hero__scan-cap:not([hidden]) {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-block-size: 44px;
    /* It arrives with the scan's own fade, once. Calm collapses it. */
    transition:
      color var(--d-fast) var(--e-out),
      opacity var(--d-slow) var(--e-out);
  }

  @starting-style {
    .hero__scan-cap:not([hidden]) {
      opacity: 0;
    }
  }

  .hero__scan-arrow {
    display: inline-block;
    transition: translate var(--d-base) var(--e-out);
  }

  .hero__scan-cap:hover,
  .hero__scan-cap:focus-visible {
    color: var(--c-bone);
  }

  .hero__scan-cap:hover .hero__scan-arrow {
    translate: 0.25em 0;
  }

  /* ------------------------------------------------------------ composition */

  .hero__inner {
    --hero-gap: clamp(1.25rem, 3.5vh, 2.5rem);
    position: relative;
    row-gap: var(--hero-gap);
    align-content: center;
  }

  .hero__role,
  .hero__block,
  .hero__disciplines,
  .hero__aside,
  .hero__cue,
  .hero__stage {
    grid-column: 1 / -1;
  }

  .hero__role {
    color: var(--c-bone-faint);
  }

  .hero__name {
    font-size: var(--t-mega);
  }

  .hero__statement {
    font-size: var(--t-statement);
    color: var(--c-bone);
    text-wrap: balance;
    max-inline-size: 18ch;
    /* Indented off the name's left edge. The offset is the composition. */
    margin-inline-start: clamp(0rem, 6vw, 9rem);
    margin-block-start: 0.12em;
  }

  .hero__disciplines {
    color: var(--c-signal);
    letter-spacing: 0.2em;
  }

  .hero__intro {
    color: var(--c-bone-dim);
    font-size: var(--t-body);
    text-wrap: pretty;
    margin-block-start: var(--s-4);
  }

  .hero__cue {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--c-bone-faint);
    justify-self: start;
    min-block-size: 44px;
    transition: color var(--d-fast) var(--e-out);
  }

  .hero__cue-line {
    inline-size: 3rem;
    block-size: 1px;
    background-color: currentColor;
    transform-origin: left center;
    transition: transform var(--d-base) var(--e-out);
  }

  .hero__cue:hover,
  .hero__cue:focus-visible {
    color: var(--c-bone);
  }

  .hero__cue:hover .hero__cue-line {
    transform: scaleX(1.4);
  }

  /**
   * DESKTOP — the magazine cover.
   * The name block takes the left nine columns, the technical readout sits in
   * the last three. That right column was empty in v0.1 and it is the single
   * biggest reason the hero read as a landing page rather than as a designed
   * page.
   */
  @media (min-width: 62rem) {
    .hero__role {
      grid-column: 1 / span 9;
    }

    .hero__block {
      grid-column: 1 / span 10;
    }

    .hero__disciplines {
      grid-column: 1 / span 7;
      align-self: end;
    }

    .hero__aside {
      grid-column: 10 / span 3;
      grid-row: 3 / span 2;
      align-self: end;
    }

    .hero__cue {
      grid-column: 1 / span 3;
    }

    .hero__stage {
      display: none;
    }

    /* Columns 7–11, the empty field right of the name, standing a quarter of
       its own width above the end of the name block. The readout begins one
       row gap below that line, and the object's ground disc reaches about
       0.23 of its width in front of where it stands, so the whole footprint
       stays clear of the table at any window height. (A percentage margin
       of a grid item is a share of its grid area's width.) */
    .hero__scan-anchor {
      grid-column: 7 / span 5;
      grid-row: 1 / span 2;
      inset-inline: 0;
      inset-block-end: 0;
      margin-block-end: 25%;
    }

    /* Under the object, on the cue's line: columns 7–9 of the row that holds
       SCROLL, right-aligned so a longer locale grows into the empty column 6,
       never into the readout. */
    .hero__scan-cap {
      grid-column: 7 / span 3;
      grid-row: 4;
      inset-block: 0;
      inset-inline-end: 0;
      margin-block: auto;
      block-size: fit-content;
    }
  }

  /**
   * MOBILE — not the desktop composition at a smaller size.
   * The readout moves under the disciplines line and becomes a two-column
   * strip, and the statement loses its indent so the block reads as one
   * left-aligned column with a clear top-to-bottom order.
   */
  @media (max-width: 61.99rem) {
    .hero {
      min-block-size: 0;
      padding-block: clamp(2.5rem, 8vh, 5rem) var(--s-7);
    }

    .hero__statement {
      margin-inline-start: 0;
      max-inline-size: 14ch;
    }

    .hero__aside :global(.readout) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--col-gap);
    }

    /* The stage: 11rem, static, in the flow from first paint (CLS 0). It sits
       a fixed --s-5 under the cue rather than the hero's viewport-relative
       row gap, so it adds a whole number of pixels to the page and nothing
       below it is moved onto a different sub-pixel. */
    .hero__stage {
      block-size: 11rem;
      margin-block-start: calc(var(--s-5) - var(--hero-gap));
    }

    /* The host lies exactly over the stage, which ends where the hero's
       bottom padding begins. The object stands centred in it, 13rem wide,
       its ground 5rem above the band's foot: roof to ground disc, it then
       fills the band without touching its edges, and stands in the oval
       clearing the ground (.hero__ground) leaves for it. */
    .hero__scan {
      inset: auto 0 var(--s-7);
      block-size: 11rem;
      mask-image: none;
    }

    .hero__scan-anchor {
      grid-column: 1 / -1;
      grid-row: 6;
      inset-inline: 0;
      inset-block-end: 5rem;
      inline-size: 13rem;
      margin-inline: auto;
    }

    /* Under the stage, right-aligned, like the caption of a figure. The stage
       is the sixth row: role, name, disciplines, aside, cue, stage. */
    .hero__scan-cap {
      grid-column: 1 / -1;
      grid-row: 6;
      inset-block-start: 100%;
      inset-inline-end: 0;
    }
  }

  /**
   * THE FLOOR — the grid lies down, and the scan stands on it.
   * Desktop. As the hero scrolls out, the column rules rotate back about
   * their bottom edge into a perspective floor (at most --floor-max-rot,
   * 50°), and the lit floor turns with them, taking over by a third of the
   * way: the standing grid is a watermark, the floor is a surface you can
   * see. It never dims while it lies down. The first name drifts onto a
   * farther plane, higher and a little smaller, the way things recede along
   * a floor; the last name follows at a third of the distance. The statement
   * holds its plane, and the aside and disciplines belong to the pointer,
   * never to scroll.
   *
   * Everything is on the root scroll timeline, so it runs on the compositor
   * (transform and opacity only) and is exactly in step with the page. It
   * starts at 8vh, so at scroll 0 nothing has a transform. `forwards` holds
   * the floor down for as long as the hero is still leaving. The names move
   * on `.line`, never on `.line__inner`, which owns the reveal.
   *
   * The floor is attached on the first scroll (`data-floor`, set by the
   * script below), not at load: a 3D animation gets a compositor layer even
   * before its range starts, and a layer under the hero's text re-rasterises
   * the text over it. Until the page moves, the hero is today's to the pixel.
   *
   * Below 62rem nothing here rotates: the stage has its own ground, drawn
   * lying down, and only the name planes move.
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      @media (min-width: 62rem) {
        :global(:root:not([data-calm])) .hero[data-floor] .hero__rules,
        :global(:root:not([data-calm])) .hero[data-floor] .hero__floor {
          transform-origin: 50% 100%;
          animation: hero-floor linear forwards;
          animation-timeline: scroll(root);
          animation-range: 8vh 70vh;
        }

        :global(:root:not([data-calm])) .hero[data-floor] .hero__floor {
          animation-name: hero-floor-lit;
        }
      }

      :global(:root:not([data-calm])) .hero__name .line {
        transform-origin: 0 50%;
        animation: hero-plane-near linear forwards;
        animation-timeline: scroll(root);
        animation-range: 8vh 60vh;
      }

      :global(:root:not([data-calm])) .hero__name .line:first-child {
        animation-name: hero-plane-far;
      }

      /* Below 62rem the hero is shorter than the viewport: it is gone sooner. */
      @media (max-width: 61.99rem) {
        :global(:root:not([data-calm])) .hero__name .line {
          animation-range: 4vh 50vh;
        }
      }
    }
  }

  /* The standing rules hand over to the lit floor in the first third. */
  @keyframes hero-floor {
    from {
      transform: perspective(var(--persp)) rotateX(0deg);
    }

    35% {
      opacity: 0;
    }

    to {
      transform: perspective(var(--persp)) rotateX(var(--floor-max-rot));
      opacity: 0;
    }
  }

  @keyframes hero-floor-lit {
    from {
      transform: perspective(var(--persp)) rotateX(0deg);
      opacity: 0;
    }

    35% {
      opacity: 1;
    }

    to {
      transform: perspective(var(--persp)) rotateX(var(--floor-max-rot));
      opacity: 1;
    }
  }

  @keyframes hero-plane-far {
    to {
      translate: 0 calc(-5vh * var(--depth-amp));
      scale: calc(1 - 0.03 * var(--depth-amp));
    }
  }

  @keyframes hero-plane-near {
    to {
      translate: 0 calc(-1.5vh * var(--depth-amp));
    }
  }
</style>

<script>
  import { initHeroPointerField } from '~/motion/hero/pointerField';
  import { REVEAL_EVENT } from '~/motion/language/enterReveal';

  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (hero) {
    /**
     * The hero waits for the language transition to hand over. Revealing it
     * underneath the cover would waste the one moment the whole entry
     * experience exists to set up.
     */
    const reveal = () => {
      hero.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-lines]').forEach((el) => {
        el.classList.add('is-revealed');
      });
      initHeroPointerField(hero);
      // The scan and its scheduler are not on the initial path: they arrive
      // in their own chunk after the reveal, and wait further in there.
    };

    document.addEventListener(REVEAL_EVENT, reveal, { once: true });

    // The floor (CSS) is attached once the page first moves; see the styles.
    addEventListener('scroll', () => hero.setAttribute('data-floor', ''), { once: true, passive: true });
  }
</script>
