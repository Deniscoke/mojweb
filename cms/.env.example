# Payload CMS environment variables
# Copy to .env and fill in real values.

# A random string used to sign tokens. Must be at least 32 characters.
PAYLOAD_SECRET=

# SQLite (local dev): file:./data/payload.db
# PostgreSQL (production): postgres://user:pass@host:5432/dbname
DATABASE_URI=file:./data/payload.db

# Public URL where this CMS is reachable.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: webhook URL to trigger Astro rebuild after content publish.
# Leave empty to disable.
SITE_REBUILD_HOOK_URL=
