# Astro frontend environment.
# Copy to .env and adjust. Never commit .env — only this example file.

# Where the Payload REST API lives. The build probes this once; if it does not
# answer, the site is built from the local files in src/data/ instead.
PUBLIC_CMS_URL=http://localhost:3000

# Set to true to make an unreachable CMS FAIL the build instead of silently
# falling back to local data. Leave false until Payload holds content that does
# not also exist in src/data/ — after that, a silent fallback ships a stale site.
CMS_REQUIRED=false
