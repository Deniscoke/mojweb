# Astro frontend environment.
# Copy to .env and adjust. Never commit .env — only this example file.

# Production origin, e.g. https://www.example.cz (protocol required, no path).
# Drives canonical, og:url, hreflang, sitemap.xml and robots.txt.
#
# - Locally, leave empty until the domain is decided: those tags are then
#   omitted rather than pointed at a guessed domain.
# - On Vercel without a custom domain, VERCEL_PROJECT_PRODUCTION_URL (the
#   *.vercel.app domain) is used automatically as a stop-gap.
# - Once a custom domain exists, set SITE_URL in the Vercel project to the
#   PRIMARY domain — the one that does not redirect (e.g. www vs apex) — and
#   redeploy. The build warns while production still relies on the stop-gap.
SITE_URL=

# Where the Payload REST API lives. The build probes this once; if it does not
# answer, the site is built from the local files in src/data/ instead.
PUBLIC_CMS_URL=http://localhost:3000

# Set to true to make an unreachable CMS FAIL the build instead of silently
# falling back to local data. Leave false until Payload holds content that does
# not also exist in src/data/ — after that, a silent fallback ships a stale site.
CMS_REQUIRED=false
